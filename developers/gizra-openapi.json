    "/api/v1/partner/update-order-status": {
      "put": {
        "tags": ["Partner API"],
        "summary": "Move an order to the next status (partner-key auth)",
        "operationId": "partnerUpdateOrderStatus",
        "x-availability": "live",
        "security": [{ "partnerKeyAuth": [], "partnerSignatureAuth": [] }],
        "parameters": [
          { "$ref": "#/components/parameters/GizraTimestamp" },
          { "$ref": "#/components/parameters/GizraSignature" }
        ],
        "description": "Identical behaviour to `POST /api/v1/vendor/update-order-status`, including the `multipart/form-data` + `_method=put` requirement (send as `POST` with the `_method` field set to `put`) — see that endpoint's description for the field list and allowed transitions.\n\nRequires scope `orders:write`. Rate limit: 60 requests/minute per key.\n\n**Signing note:** the signature is computed over the raw multipart body exactly as sent, same as any other request — compute it after building the final multipart payload, not over the logical field values.",
        "responses": {
          "200": { "description": "Status updated" },
          "401": { "$ref": "#/components/responses/PartnerUnauthorized" },
          "403": { "$ref": "#/components/responses/PartnerForbidden" },
          "404": { "description": "Order not found or not owned by this key's restaurant" },
          "429": { "$ref": "#/components/responses/RateLimited" }
        }
      }
