    "/api/v1/vendor/current-orders": {
      "get": {
        "tags": ["Orders"],
        "summary": "All active orders",
        "operationId": "getCurrentOrders",
        "x-availability": "live",
        "description": "**This is the primary polling endpoint.**\n\nReturns every order that is not yet finished: statuses `pending`, `accepted`, `confirmed`, `processing`, `handover`, `picked_up`.\n\nRecommended polling interval is 10-30 seconds. Diff the returned `id` values against orders already imported; anything new with `order_status: \"pending\"` is a new order for the kitchen.\n\nThe response is a bare JSON array, not an envelope.",
        "responses": {
          "200": {
            "description": "Active orders",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/Order" }
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },

    "/api/v1/vendor/completed-orders": {
      "get": {
        "tags": ["Orders"],
        "summary": "Finished orders, paginated",
        "operationId": "getCompletedOrders",
        "x-availability": "live",
        "description": "Order history. Paginated with `offset` (1-based page number) and `limit`.",
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "required": true,
            "schema": { "type": "string", "enum": ["all", "delivered", "refunded", "canceled", "failed"], "default": "all" },
            "description": "Filter by final status."
          },
          {
            "name": "offset",
            "in": "query",
            "required": true,
            "schema": { "type": "integer", "minimum": 1, "default": 1 },
            "description": "1-based page number, not a row offset."
          },
          {
            "name": "limit",
            "in": "query",
            "required": true,
            "schema": { "type": "integer", "minimum": 1, "maximum": 100, "default": 10 },
            "description": "Rows per page."
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated history",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/PaginatedOrders" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },

    "/api/v1/vendor/order": {
      "get": {
        "tags": ["Orders"],
        "summary": "One order header",
        "operationId": "getOrder",
        "x-availability": "live",
        "description": "Single order record. Same shape as one element of `current-orders`. Does not include line items — use `/api/v1/vendor/order-details` for those.",
        "parameters": [
          {
            "name": "order_id",
            "in": "query",
            "required": true,
            "schema": { "type": "integer" },
            "example": 100152
          }
        ],
        "responses": {
          "200": {
            "description": "Order",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Order" } } }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "description": "Order not found or not owned by this restaurant" }
        }
      }
    },

    "/api/v1/vendor/order-details": {
      "get": {
        "tags": ["Orders"],
        "summary": "Line items for one order",
        "operationId": "getOrderDetails",
        "x-availability": "live",
        "description": "The items the kitchen has to make: food, chosen variations, add-ons, quantity and price.\n\nThe array is nested under `order.details` in the response body.",
        "parameters": [
          {
            "name": "order_id",
            "in": "query",
            "required": true,
            "schema": { "type": "integer" },
            "example": 100152
          }
        ],
        "responses": {
          "200": {
            "description": "Order with its line items",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "order": {
                      "type": "object",
                      "properties": {
                        "details": {
                          "type": "array",
                          "items": { "$ref": "#/components/schemas/OrderDetail" }
