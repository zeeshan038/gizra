    "/api/v1/vendor/update-order-status": {
      "post": {
        "tags": ["Order status"],
        "summary": "Move an order to the next status",
        "operationId": "updateOrderStatus",
        "x-availability": "live",
        "description": "Pushes kitchen progress back to GIZRA. This is what makes the customer app show \"confirmed\", \"being prepared\", \"on the way\".\n\n**Two things to note about the request format:**\n\n1. The body is `multipart/form-data`, not JSON. This is because the same endpoint optionally accepts delivery proof images.\n2. It is a POST that carries `_method=put`. Laravel method spoofing. Send the literal field `_method` with value `put`.\n\n### Allowed transitions\n\n| From | To | Notes |\n|---|---|---|\n| `pending` | `confirmed` | Restaurant accepts the order. |\n| `pending` | `canceled` | Only if the platform allows restaurant cancellation (`canceled_by_restaurant` in `/api/v1/config`). `reason` is required. |\n| `confirmed` | `processing` | Kitchen starts cooking. Send `processing_time` in minutes. |\n| `processing` | `handover` | Food is ready for the courier. |\n| `handover` | `delivered` | Only for self-delivery or take-away. Requires `otp` when `order_delivery_verification` is true in `/api/v1/config`. |\n\nSending a transition that is not allowed for the order's current status returns a non-200 with a message.",
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": ["order_id", "status", "_method"],
                "properties": {
                  "_method": {
                    "type": "string",
                    "enum": ["put"],
                    "description": "Always the literal string `put`."
                  },
                  "order_id": { "type": "integer", "example": 100152 },
                  "status": {
                    "type": "string",
                    "enum": ["confirmed", "processing", "handover", "delivered", "canceled"],
                    "example": "processing"
                  },
                  "processing_time": {
                    "type": "string",
                    "description": "Preparation time in whole minutes. Send when moving to `processing`. Empty string otherwise.",
                    "example": "20"
                  },
                  "otp": {
                    "type": "string",
                    "description": "Delivery verification code from the customer. Required for `delivered` when `order_delivery_verification` is true. Empty string otherwise.",
                    "example": ""
                  },
                  "reason": {
                    "type": "string",
                    "description": "Cancellation reason. Required when `status` is `canceled`. Omit the field entirely otherwise.",
                    "example": "Item out of stock"
                  },
                  "order_proof[]": {
                    "type": "array",
                    "items": { "type": "string", "format": "binary" },
                    "description": "Optional delivery proof images."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Status updated",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": { "message": { "type": "string" } }
                },
                "example": { "message": "Order status updated successfully" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "description": "Transition not permitted for this order or restaurant" },
          "404": { "description": "Order not found or not owned by this restaurant" }
        }
      }
    },

